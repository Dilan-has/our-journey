{
  "name": "our-journey",
  "version": "1.0.0",
  "description": "Una aplicación web sincrónica para parejas",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "node server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "vite build",
    "start": "node server.js",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "express": "^4.19.2",
    "lucide-vue-next": "^0.359.0",
    "vue": "^3.4.21",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^6.4.3",
    "wrangler": "^4.113.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
